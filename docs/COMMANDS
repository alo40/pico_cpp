# add variable (permanent)
echo 'export PICO_SDK_PATH=$HOME/pico-sdk' >> ~/.bashrc
source ~/.bashrc

# build firmware and run parser unit tests
scripts/compile.sh

# clean, rebuild, and run parser unit tests
scripts/compile.sh clean

# build, test, and flash with picotool
scripts/compile_flash.sh

# clean, build, test, and flash with picotool
scripts/compile_flash.sh clean

# find mount point (with Pico in BOOTSEL mode)
lsblk

# flash
cp pico_app.uf2 /media/$USER/RPI-RP2/
sync

# use screen (serial)
ls /dev/ttyACM*
screen /dev/ttyACM0 115200
Ctrl + A, then K to exit

# copy from raspi to mac
ssh fori@192.168.0.78 'cat /home/fori/pico_cpp/oled_time.c' | pbcopy
ssh fori@192.168.0.78 'cat /home/fori/pico_cpp/ssd1306.c' | pbcopy
